{
  "binding": "scanned",
  "preload": "scanned",
  "illustration": {
    "library": "storyset",
    "style": "Amico",
    "globalIllustrations": {
      "empty": "amico-empty-hidden"
    },
    "placeholder": {
      "name": "amico-empty-hidden"
    },
    "fallback": "amico-empty-hidden"
  },
  "logo": {
    "globalLogos": {
      "apple": "apple",
      "gmail": "gmail",
      "google": "google",
      "placeholder": "apple",
      "youtube": "youtube"
    },
    "placeholder": {
      "name": "apple"
    },
    "fallback": "apple",
    "variant": "mono"
  },
  "colorLogo": {
    "globalColorLogos": {
      "amex": "amex",
      "chrome": "chrome",
      "discover": "discover",
      "google": "google",
      "mastercard": "mastercard",
      "placeholder": "google-gmail",
      "visa": "visa",
      "youtube": "youtube"
    },
    "placeholder": {
      "name": "google-gmail"
    },
    "fallback": "google-gmail",
    "variant": "color"
  },
  "flag": {
    "library": "flagpack",
    "globalFlags": {
      "default": "IN",
      "us": "US"
    },
    "placeholder": {
      "code": "IN"
    },
    "fallback": "US"
  },
  "emoji": {
    "family": "apple",
    "skinTone": "medium-light",
    "globalEmojis": {
      "bust_in_silhouette": "bust_in_silhouette",
      "credit_card": "credit_card",
      "envelope": "envelope",
      "link": "link",
      "magnifying_glass_tilted_left": "magnifying_glass_tilted_left",
      "placeholder": "waving_hand"
    },
    "placeholder": {
      "name": "waving_hand"
    },
    "fallback": "waving_hand"
  },
  "loader": {
    "library": "ldrs",
    "name": "ring",
    "color": "currentColor",
    "speed": 1,
    "globalLoaders": {
      "default": "ring",
      "spinner": "line-spinner"
    },
    "placeholder": {
      "name": "ring"
    },
    "fallback": "ring"
  },
  "fileType": {
    "library": "vscode",
    "globalFileTypes": {
      "document": "pdf",
      "spreadsheet": "excel"
    },
    "placeholder": {
      "extension": "excel"
    },
    "fallback": "pdf"
  },
